generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int          @id @default(autoincrement())
  name         String
  target_hba1c Float?
  is_pump_user Boolean      @default(false)
  glucoseLogs  GlucoseLog[]
  mealLogs     MealLog[]
}

model GlucoseLog {
  id            Int      @id @default(autoincrement())
  userId        Int
  glucose_level Int
  measured_at   DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])
}

model MealLog {
  id           Int      @id @default(autoincrement())
  userId       Int
  total_carbs  Int
  insulin_dose Float?
  logged_at    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
}
